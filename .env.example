# Example values only. Copy this file to .env for local development.
# npm run be:dev loads .env when that file exists. Shell variables win over the file.
# The production process does not read .env. Set Coolify and Cloudflare values in their secret stores.
# POSTGRES_TEST_URL is for the Postgres store contract, not the running server.
# On Coolify, DATABASE_URL uses the Postgres container hostname, not localhost.

D1_GATEWAY_URL=https://url-shortener.example.workers.dev
D1_GATEWAY_TOKEN=replace-with-gateway-token
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/web_tools
PUBLIC_BASE_URL=https://tools.example.com
URL_SHORTENER_TTL_SECONDS=2592000
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_PER_DAY=200
MAX_ACTIVE_LINKS=100000
POSTGRES_TEST_URL=postgres://postgres:postgres@127.0.0.1:5432/web_tools_test
